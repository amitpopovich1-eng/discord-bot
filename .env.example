# חובה
DISCORD_TOKEN=your-bot-token
CLIENT_ID=your-application-id

# מומלץ: רישום פקודות מיידי לשרת אחד (בלי זה - גלובלי, לוקח עד שעה)
GUILD_ID=

# אזור זמן לתזמונים (שאלת יום, טבלה שבועית, סטריק)
TZ=Asia/Jerusalem

# אימות עם הוכחת בעלות (ראו docs/minecraft-plugin.md). בלי זה האימות הוא "על דברי השחקן".
# צרו סוד עם: openssl rand -hex 32
API_SECRET=
API_PORT=3000
