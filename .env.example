# חובה
DISCORD_TOKEN=
CLIENT_ID=

# מומלץ: רישום פקודות מיידי לשרת אחד (בלי זה - גלובלי, לוקח עד שעה)
GUILD_ID=

# אזור זמן לתזמונים (שאלת יום, טבלה שבועית, סטריק)
TZ=Asia/Jerusalem

# אימות חשבון מיינקראפט דרך Hypixel. בלי המפתח האימות כבוי (הבוט לא מעניק רול מאומת).
# מקבלים מפורטל המפתחים של Hypixel (ראו docs/verification.md). אסור לשתף או לפרסם.
HYPIXEL_API_KEY=

# נתיב קובץ ה-DB. בפריסה בענן חייב להיות על volume קבוע (למשל /data/bot.db)
# DB_PATH=/data/bot.db
